{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-timeline-import-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0
  },
  "vars": {
    "APPLE_CLIENT_ID": "com.example.RecipeTimeline",
    "RECIPE_PROVIDER": "grok",
    "GROK_MODEL": "grok-4.6",
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "replace-with-production-kv-id",
      "preview_id": "replace-with-preview-kv-id"
    }
  ],
  "ratelimits": [
    {
      "name": "IMPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}

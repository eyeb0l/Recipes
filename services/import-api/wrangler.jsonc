{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-timeline-import-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0
  },
  "vars": {
    "APPLE_CLIENT_ID": "com.irisgiertuga.RecipeTimeline",
    "OPENAI_MODEL": "gpt-6.1-terra"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "efdc4d1244ad4c329a8bbe374af5a726",
      "preview_id": "6d59a62df5fb46d895977ffa0da54e43"
    }
  ],
  "ratelimits": [
    {
      "name": "IMPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}

{
  "name": "recipe-timeline-import-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live:sites": "node --import tsx scripts/recipe-site-compat.ts",
    "test:live:openai": "env -u OPENAI_API_KEY node --env-file=.dev.vars --import tsx scripts/live-contract.ts"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "ajv": "^8.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0"
}

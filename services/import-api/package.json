{
  "name": "recipe-timeline-import-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live:grok": "env -u XAI_API_KEY node --env-file=.dev.vars --import tsx scripts/live-contract.ts grok",
    "test:live:openai": "env -u OPENAI_API_KEY node --env-file=.dev.vars --import tsx scripts/live-contract.ts openai"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "ajv": "^8.17.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.28.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recipe-timeline.app/schema/recipe-v1.json",
  "title": "Recipe Timeline canonical recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "yield",
    "ingredients",
    "prepTasks",
    "workstreams",
    "stages",
    "uncertainties",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": ["string", "null"] },
    "yield": { "$ref": "#/$defs/recipeYield" },
    "ingredients": {
      "type": "array",
      "items": { "$ref": "#/$defs/ingredient" }
    },
    "prepTasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/prepTask" }
    },
    "workstreams": {
      "type": "array",
      "items": { "$ref": "#/$defs/workstream" }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "uncertainties": {
      "type": "array",
      "items": { "$ref": "#/$defs/uncertainty" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "recipeYield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servings", "label"],
      "properties": {
        "servings": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": ["string", "null"] }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "lower", "upper", "text", "unit", "originalText"],
      "properties": {
        "kind": { "type": "string", "enum": ["exact", "range", "text"] },
        "value": { "type": ["number", "null"] },
        "lower": { "type": ["number", "null"] },
        "upper": { "type": ["number", "null"] },
        "text": { "type": ["string", "null"] },
        "unit": { "$ref": "#/$defs/unitID" },
        "originalText": { "type": ["string", "null"] }
      }
    },
    "unitID": {
      "type": "string",
      "enum": [
        "none", "gram", "kilogram", "ounce", "pound",
        "milliliter", "liter", "teaspoon", "tablespoon", "cup", "fluidOunce", "pint",
        "celsius", "fahrenheit",
        "count", "pinch", "clove", "slice", "can", "package", "bunch", "sprig", "shot"
      ]
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "quantity", "scalable", "notes", "sortIndex"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "quantity": { "anyOf": [{ "$ref": "#/$defs/quantity" }, { "type": "null" }] },
        "scalable": { "type": "boolean" },
        "notes": { "type": ["string", "null"] },
        "sortIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "prepTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instruction", "ingredientIDs", "isOptional", "sortIndex"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "ingredientIDs": { "type": "array", "items": { "type": "string" } },
        "isOptional": { "type": "boolean" },
        "sortIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sortIndex"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sortIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "ingredientUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingredientID", "quantity", "stateChange"],
      "properties": {
        "ingredientID": { "type": "string", "minLength": 1 },
        "quantity": { "anyOf": [{ "$ref": "#/$defs/quantity" }, { "type": "null" }] },
        "stateChange": { "type": ["string", "null"] }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSeconds", "maximumSeconds", "isPassive"],
      "properties": {
        "minimumSeconds": { "type": "integer", "minimum": 0 },
        "maximumSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "isPassive": { "type": "boolean" }
      }
    },
    "temperature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["celsius", "fahrenheit"] }
      }
    },
    "stageTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "durationSeconds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "durationSeconds": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "action", "instruction", "completionCue", "workstreamID", "dependencies",
        "ingredientUses", "resultLabel", "duration", "timers", "heat", "temperature", "notes", "sortIndex"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "completionCue": { "type": ["string", "null"] },
        "workstreamID": { "type": ["string", "null"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "ingredientUses": { "type": "array", "items": { "$ref": "#/$defs/ingredientUse" } },
        "resultLabel": { "type": ["string", "null"] },
        "duration": { "anyOf": [{ "$ref": "#/$defs/duration" }, { "type": "null" }] },
        "timers": { "type": "array", "items": { "$ref": "#/$defs/stageTimer" } },
        "heat": { "type": ["string", "null"] },
        "temperature": { "anyOf": [{ "$ref": "#/$defs/temperature" }, { "type": "null" }] },
        "notes": { "type": ["string", "null"] },
        "sortIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "severity", "message", "ingredientIDs", "stageIDs", "sourceEvidence", "isResolved"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["missingPlacement", "conflictingSource", "ambiguousQuantity", "ambiguousTiming", "ambiguousState", "other"] },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "message": { "type": "string", "minLength": 1 },
        "ingredientIDs": { "type": "array", "items": { "type": "string" } },
        "stageIDs": { "type": "array", "items": { "type": "string" } },
        "sourceEvidence": { "type": ["string", "null"] },
        "isResolved": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "url", "title", "cleanedText", "importedAt"],
      "properties": {
        "sourceType": { "type": "string", "enum": ["url", "text", "images", "manual", "sample"] },
        "url": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "cleanedText": { "type": ["string", "null"] },
        "importedAt": { "type": "string" }
      }
    }
  }
}
